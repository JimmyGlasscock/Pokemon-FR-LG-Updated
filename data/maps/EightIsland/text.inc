EightIsland_Text_IslandSign::
	.string "EIGHT ISLAND\n"
	.string "The Island of Mystic Springs$"

EightIsland_Text_LassWelcome::
	.string "Welcome to Eight Island!\p"
	.string "The hot springs here are said to\n"
	.string "have healing properties!$"

